    {"type": "wifi_link", "every": 30},
    {"type": "sys", "every": 60},
    {"type": "ping", "every": 60, "params": {"host": "192.168.10.1", "count": 3}},
    {"type": "wifi_scan", "every": 300, "params": {"keep_networks": 15}}
  ]
}
