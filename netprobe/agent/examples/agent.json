{
  "agent_id": "alpha-sonde-01",
  "secret": "REMPLACER-PAR-LE-SECRET-GENERE-PAR-LE-CENTRAL",
  "site": "alpha",
  "role": "probe",
  "collector_url": "http://192.168.10.20:6127",
  "interface": "wlan0",
  "poll_config_seconds": 300,
  "flush_seconds": 30,
  "batch_size": 100,
  "queue_path": "/var/lib/netprobe-agent/queue.db",
